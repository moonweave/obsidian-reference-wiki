%!PS-Adobe-3.0
%%Pages: 8
%%BoundingBox: 0 0 612 792
%%EndComments
<< /PageSize [612 792] >> setpagedevice
/Helvetica findfont 12 scalefont setfont

%%Page: 1 1
72 730 moveto (SINGLE COLUMN START) show
72 700 moveto (The actuator response was measured under condition alpha.) show
72 670 moveto (SINGLE COLUMN RESULT 12 MILLIAMPERE) show
72 640 moveto (SINGLE COLUMN END) show
showpage

%%Page: 2 2
/Helvetica findfont 12 scalefont setfont
72 730 moveto (TWO COLUMN CASE) show
72 690 moveto (LEFT COLUMN START) show
72 660 moveto (LEFT COLUMN RESULT SAMPLE ALPHA) show
330 690 moveto (RIGHT COLUMN START) show
330 660 moveto (RIGHT COLUMN LIMITATION ONE TRIAL) show
72 100 moveto (TWO COLUMN END) show
showpage

%%Page: 3 3
/Helvetica findfont 12 scalefont setfont
72 730 moveto (EQUATION TEXT CASE) show
72 690 moveto (CURRENT I EQUALS VOLTAGE V OVER RESISTANCE R) show
72 650 moveto (ENERGY E EQUALS CHARGE Q TIMES VOLTAGE V) show
72 610 moveto (EQUATION TEXT END) show
showpage

%%Page: 4 4
/Helvetica findfont 12 scalefont setfont
72 730 moveto (TABLE CASE) show
newpath 72 690 moveto 500 690 lineto 500 570 lineto 72 570 lineto closepath stroke
newpath 72 650 moveto 500 650 lineto stroke
newpath 72 610 moveto 500 610 lineto stroke
newpath 280 690 moveto 280 570 lineto stroke
90 665 moveto (SAMPLE ALPHA) show
310 665 moveto (VALUE 12) show
90 625 moveto (SAMPLE BETA) show
310 625 moveto (VALUE 5) show
90 585 moveto (TABLE END) show
showpage

%%Page: 5 5
/Helvetica findfont 10 scalefont setfont
72 755 moveto (REPEATED HEADER JOURNAL TEST) show
/Helvetica findfont 12 scalefont setfont
72 700 moveto (HEADER FOOTER BODY START) show
72 660 moveto (The body retains the reported control comparison.) show
72 620 moveto (HEADER FOOTER BODY END) show
/Helvetica findfont 10 scalefont setfont
72 35 moveto (FOOTER PAGE FIVE) show
showpage

%%Page: 6 6
/Helvetica findfont 12 scalefont setfont
72 730 moveto (SPARSE PAGE TITLE) show
260 400 moveto (SPARSE CENTRAL NOTE) show
72 80 moveto (SPARSE PAGE END) show
showpage

%%Page: 7 7
gsave
90 rotate
0 -612 translate
/Helvetica findfont 12 scalefont setfont
72 540 moveto (ROTATED TEXT CASE) show
72 500 moveto (ROTATED RESULT PRESERVED) show
72 460 moveto (ROTATED TEXT END) show
grestore
showpage

%%Page: 8 8
/Helvetica findfont 12 scalefont setfont
72 730 moveto (GRAPHICS CAPTION CASE) show
newpath 100 420 moveto 100 650 lineto 470 650 lineto 470 420 lineto closepath stroke
newpath 120 450 moveto 220 520 lineto 320 490 lineto 440 610 lineto stroke
72 380 moveto (FIGURE ONE RESPONSE CURVE) show
72 340 moveto (GRAPHICS CAPTION RESULT INCREASES) show
72 300 moveto (GRAPHICS CAPTION END) show
showpage
